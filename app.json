{
  "expo": {
    "name": "Eizi",
    "slug": "raza-software-eng",
    "scheme": "eizi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.razatech.eizi"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#083B36",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.razatech.eizi"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0B6358",
          "sounds": ["./assets/sounds/booking.wav", "./assets/sounds/confirmed.wav"]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Eizi uses your location only when you book, so the service provider can find your address."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#083B36",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Eizi needs access to your photos so you can choose a profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/c9cfdcc2-da74-4fd7-aa5f-de2d75160caf"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c9cfdcc2-da74-4fd7-aa5f-de2d75160caf"
      }
    },
    "owner": "razasoftwareengs-team"
  }
}
